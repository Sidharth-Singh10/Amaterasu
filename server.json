{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sidharth-Singh10/tenon",
  "title": "Tenon",
  "description": "Typed, reversible, auditable document ops for AI agents and humans.",
  "websiteUrl": "https://sidharth-singh10.github.io/Amaterasu/",
  "repository": {
    "url": "https://github.com/Sidharth-Singh10/Amaterasu",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@tenon-protocol/mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TENON_URL",
          "description": "Base URL of the running Tenon server",
          "format": "string",
          "isRequired": false,
          "default": "http://127.0.0.1:8787"
        }
      ]
    }
  ]
}
