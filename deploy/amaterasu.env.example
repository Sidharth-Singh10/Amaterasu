# Amaterasu environment (copy to .env, chmod 600, and fill in).
# Replace /home/levi with the deploy user's home everywhere.

# --- Bind and public URLs ---
AMATERASU_BIND=127.0.0.1:8787
# The OAuth redirect URI is derived from BASE_URL (BASE_URL + /api/indmoney/oauth/callback),
# so this must be the public HTTPS origin.
AMATERASU_BASE_URL=https://charts.example.com
AMATERASU_APP_URL=https://charts.example.com
AMATERASU_STATIC_DIR=/home/levi/amaterasu/web/build
AMATERASU_DATA_DIR=/home/levi/.local/share/amaterasu

# --- OpenCode bridge ---
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Shared secret for the OpenCode server: OPENCODE_PASSWORD is what the app sends,
# OPENCODE_SERVER_PASSWORD is what the server expects. Same value.
OPENCODE_PASSWORD=CHANGE_ME_OPENCODE_PASSWORD
OPENCODE_SERVER_PASSWORD=CHANGE_ME_OPENCODE_PASSWORD
OPENCODE_AGENT=chart-analyst
# Primary sessions ignore the agent file's model, so the bridge pins it here.
# Pick a model your VPS providers can serve that handles the full Code Mode catalog.
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_DIRECTORY=/home/levi/amaterasu/opencode

# --- INDmoney MCP (defaults shown; uncomment to override) ---
# INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
# INDMONEY_SCOPE=market:read portfolio:read
