{
  "id": "malformed-op",
  "kind": "malformed_op",
  "title": "Malformed envelopes and payloads are rejected with typed codes",
  "description": "No silent failure: a missing actor is invalid_op, an unknown type is unknown_op_type, a bad payload is invalid_op, and a missing target is unknown_target. Rejections do not change the document.",
  "docId": "doc_conformance",
  "setup": {
    "objects": [],
    "capabilities": [
      {
        "v": 1,
        "cap_id": "cap_write",
        "iss": "tenon-local",
        "sub": { "actor_id": "conformance", "session": "ses_conformance" },
        "documents": ["doc_*"],
        "op_types": ["obj.point.*", "obj.viewport.*"],
        "permissions": ["read", "apply", "undo"],
        "approval": { "mode": "auto", "op_types": [] },
        "issued_at": "2026-01-01T00:00:00Z",
        "expires_at": "2030-01-01T00:00:00Z"
      }
    ]
  },
  "actor": { "kind": "agent", "id": "conformance", "session": "ses_conformance" },
  "capability": "cap_write",
  "steps": [
    {
      "kind": "apply_raw",
      "envelope": {
        "v": 1,
        "doc_id": "doc_conformance",
        "turn_id": "turn_1",
        "seq": 1,
        "capability": "cap_write",
        "type": "obj.point.create",
        "target": { "kind": "point" },
        "payload": { "id": "o1", "data": { "x": 1, "y": 2 } },
        "idempotency_key": "turn_1:1",
        "created_at": "2026-10-20T09:41:02Z"
      },
      "expect": { "status": "rejected", "code": "invalid_op", "revision": 0 }
    },
    {
      "kind": "apply",
      "op": {
        "type": "obj.point.explode",
        "turn": "turn_2",
        "target": { "kind": "obj" },
        "payload": {}
      },
      "expect": { "status": "rejected", "code": "unknown_op_type", "revision": 0 }
    },
    {
      "kind": "apply",
      "op": {
        "type": "obj.point.create",
        "turn": "turn_3",
        "target": { "kind": "point" },
        "payload": { "id": "o1" }
      },
      "expect": { "status": "rejected", "code": "invalid_op", "revision": 0 }
    },
    {
      "kind": "apply",
      "op": {
        "type": "obj.point.update",
        "turn": "turn_4",
        "target": { "kind": "point", "id": "ghost" },
        "payload": { "data": { "x": 1, "y": 2 } }
      },
      "expect": { "status": "rejected", "code": "unknown_target", "revision": 0 }
    },
    { "kind": "snapshot", "expect": { "revision": 0, "objectCount": 0 } },
    { "kind": "verify_audit", "expect": { "ok": true, "length": 3 } }
  ]
}
