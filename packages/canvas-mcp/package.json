{
  "name": "@common-ground/canvas-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for Common Ground document state, ops, undo, and history",
  "license": "MIT",
  "mcpName": "io.github.Sidharth-Singh10/common-ground",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidharth-Singh10/Amaterasu.git",
    "directory": "packages/canvas-mcp"
  },
  "homepage": "https://sidharth-singh10.github.io/Amaterasu/",
  "bugs": {
    "url": "https://github.com/Sidharth-Singh10/Amaterasu/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "common-ground",
    "ai-agents",
    "audit",
    "undo"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "common-ground-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@common-ground/canvas-core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.6.5"
  }
}
